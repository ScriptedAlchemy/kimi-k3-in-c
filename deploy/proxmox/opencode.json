{
  "$schema": "https://opencode.ai/config.json",
  "model": "kimi-local/kimi-k3",
  "small_model": "kimi-local/kimi-k3",
  "provider": {
    "kimi-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kimi K3 Local Exact",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "local"
      },
      "models": {
        "kimi-k3": {
          "name": "Kimi K3 (official MXFP4/BF16)",
          "limit": {
            "context": 8192,
            "output": 512
          }
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 1024
  }
}
